// 大乐透AI_V90
// Data Engine
// 历史开奖数据管理


window.DataEngine = {


    history: [],


    loaded:false,



    // 初始化

    async init(){


        await this.loadData();


    },





    // 加载历史数据


    async loadData(){


        try{


            let response =

            await fetch(
                "data/dlt.txt"
            );



            let text =

            await response.text();



            this.history =

            this.parseData(
                text
            );



            this.loaded=true;



            console.log(
                "历史数据加载完成:",
                this.history.length
            );



        }catch(error){



            console.error(
                "数据加载失败",
                error
            );



            this.history=[];



        }



    },









    // 数据解析


    parseData(text){



        let lines =

        text
        .split("\n")
        .filter(
            line =>
            line.trim()!==""
        );



        let result=[];



        for(
            let line of lines
        ){


            let item =

            this.parseLine(
                line
            );



            if(item){

                result.push(item);

            }


        }



        return result;


    },









    // 单行解析


    parseLine(line){



        /*
        
        支持格式：

        2026001 01 05 12 23 35 03 08

        或

        01 05 12 23 35 + 03 08

        */



        let clean =

        line.replace(
            /\+/g,
            " "
        );



        let nums =

        clean
        .split(
            /\s+/
        )
        .map(
            Number
        )
        .filter(
            n =>
            !isNaN(n)
        );



        if(
            nums.length < 7
        ){

            return null;

        }



        let start = 0;



        // 如果第一位是期号

        if(
            nums.length >=8
        ){

            start=1;

        }




        return {


            front:


            nums.slice(
                start,
                start+5
            ),



            back:


            nums.slice(
                start+5,
                start+7
            )



        };



    },









    // 获取全部历史


    getHistory(){


        return this.history;


    },







    // 获取最近多少期


    getRecent(
        count=100
    ){


        return this.history.slice(
            -count
        );


    },







    // 获取最新一期


    getLatest(){


        return this.history[
            this.history.length-1
        ];


    }



};