加载进度引擎
================================
*/


class LoadingEngine{


    constructor(){


        this.name="loading";


        this.progress=0;


        this.message="等待分析";


        this.history=[];


    }









    // ==========================
    // 更新进度
    // ==========================


    update(progress,message){



        this.progress=

        Math.min(

            100,

            Math.max(

                0,

                progress

            )

        );







        this.message=

        message || "";








        let state={



            progress:

            this.progress,



            message:

            this.message,



            time:

            Date.now()



        };








        this.history.push(state);







        this.send();



        return state;



    }









    // ==========================
    // 通知页面
    // ==========================


    send(){



        if(

        typeof window !== "undefined"

        ){



            window.dispatchEvent(

                new CustomEvent(

                    "V90_PROGRESS",

                    {

                        detail:{


                            progress:

                            this.progress,


                            message:

                            this.message



                        }

                    }

                )

            );



        }



    }









    // ==========================
    // 重置
    // ==========================


    reset(){



        this.progress=0;


        this.message="等待分析";


        this.history=[];


        this.send();



    }









    // ==========================
    // 获取状态
    // ==========================


    get(){



        return {



            progress:

            this.progress,



            message:

            this.message



        };



    }







    status(){



        return {



            engine:this.name,


            ...this.get()



        };



    }



}







window.loadingengine=

new LoadingEngine();