{
  "version": "v21.5",

  "description": "大乐透+排列五历史数据配置",

  "datasets": {

    "dlt": {

      "name": "超级大乐透",

      "file": "dlt_history.txt",

      "format": {

        "front": 5,

        "back": 2

      },

      "range": {

        "front_min": 1,

        "front_max": 35,

        "back_min": 1,

        "back_max": 12

      },

      "status": "active"

    },


    "pl5": {

      "name": "排列五",

      "file": "pl5_history.txt",

      "format": {

        "digits": 5

      },

      "range": {

        "min": 0,

        "max": 9

      },

      "status": "active"

    }

  },


  "analysis": {

    "remove_empty_line": true,

    "allow_duplicate_check": true,

    "latest_first": true

  },


  "statistics": {

    "dlt_periods": 0,

    "pl5_periods": 0,

    "last_update": null

  }

}