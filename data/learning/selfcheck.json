{
  "version": "V90",

  "name": "AI系统自检配置",


  "enabled": true,


  "checks": {


    "data_check": {


      "enabled": true,


      "min_periods": 50,


      "required_fields": [

        "period",

        "date",

        "front",

        "back"

      ]

    },



    "model_check": {


      "enabled": true,


      "check_weight_sum": true,


      "weight_target": 1.0

    },



    "prediction_check": {


      "enabled": true,


      "check_duplicate": true,


      "check_range": true,


      "check_structure": true

    },



    "performance_check": {


      "enabled": true,


      "max_runtime_second": 60,


      "memory_safe": true

    }


  },



  "conflict_detection": {


    "enabled": true,


    "compare_models": [

      "bayes",

      "markov",

      "montecarlo",

      "structure"

    ],


    "threshold": 0.3


  },



  "output_rules": {


    "allow_prediction": true,


    "allow_report": true,


    "warning_level": [

      "low",

      "medium",

      "high"

    ]

  },



  "description":

  "V90 AI运行前后自检系统"

}