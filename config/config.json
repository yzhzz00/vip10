{
  "system": {

    "name": "DLT-AI-CORE",

    "version": "V11 FINAL",

    "mode": "production"

  },


  "data": {

    "history_file": "./data/dlt_history.txt",

    "database": "./data/database.sqlite",

    "model_state": "./data/model_state.json",

    "prediction_history": "./data/prediction_history.json",

    "feedback_history": "./data/feedback_history.json"

  },


  "model": {

    "committee": true,

    "frequency": {

      "weight": 0.2

    },

    "trend": {

      "weight": 0.2

    },

    "bayes": {

      "weight": 0.2

    },

    "markov": {

      "weight": 0.2

    },

    "montecarlo": {

      "weight": 0.2

    }

  },


  "montecarlo": {

    "simulation": 100000

  },


  "learning": {

    "enabled": true,

    "rate": 0.05

  },


  "validation": {

    "enabled": true,

    "window": 100

  },


  "server": {

    "port": 3000

  }

}